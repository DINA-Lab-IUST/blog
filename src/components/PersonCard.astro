---
/**
 * PersonCard — bilingual lab member card (English + Persian blocks).
 * Visibility per language is handled in CSS via `.who-en` / `.who-fa`
 * (see global.css), driven by the visitor's chrome language.
 * Supervisors get a gold badge + gold avatar ring (DINA identity).
 */
import { withBase } from '@utils/base';
import type { CollectionEntry } from 'astro:content';

import IconScholar from '~icons/academicons/google-scholar';
import IconGithub from '~icons/fa-brands/github';
import IconLinkedin from '~icons/fa-brands/linkedin';

interface Props {
  person: CollectionEntry<'people'>;
  lead?: boolean;
  /** Horizontal full-row layout (supervisor): avatar beside the content. */
  horizontal?: boolean;
}

const { person, lead = false, horizontal = false } = Astro.props;
const focus = person.data.focus ?? [];
---

<div class:list={['member-card', 'text-center', lead && 'is-lead', horizontal && 'is-horizontal']}>
  <div class="member-inner">
    <div class="member-avatar-ring">
      <span class="member-initial" aria-hidden="true">
        {person.data.name.charAt(0)}
      </span>
      {
        person.data.photo && (
          <img
            src={withBase(person.data.photo)}
            alt={person.data.name}
            loading="lazy"
            width="104"
            height="104"
            onerror="this.remove()"
          />
        )
      }
    </div>

    <div class="member-body">
      <h3 class="who-en member-name">
        {
          person.data.website ? (
            <a
              href={person.data.website}
              target="_blank"
              rel="noopener noreferrer"
              style="color: inherit; text-decoration: none;"
            >
              {person.data.name}
            </a>
          ) : (
            person.data.name
          )
        }
      </h3>
      {
        person.data.nameFa && (
          <p class="who-fa member-name" lang="fa" dir="rtl">
            {person.data.nameFa}
          </p>
        )
      }
      <p class="who-en member-role">{person.data.role}</p>
      {
        person.data.roleFa && (
          <p class="who-fa member-role" lang="fa" dir="rtl">
            {person.data.roleFa}
          </p>
        )
      }

      {
        focus.length > 0 && (
          <div class="member-focus" aria-label="Research focus">
            {focus.slice(0, 3).map((tag) => (
              <span class="focus-chip">{tag}</span>
            ))}
          </div>
        )
      }

      {/* Social icons */}
      <div class="person-socials">
        {
          person.data.github && (
            <a
              href={`https://github.com/${person.data.github}`}
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs"
              style="color: var(--global-text-color-light); text-decoration: none;"
              aria-label="GitHub"
              title="GitHub"
            >
              <IconGithub />
            </a>
          )
        }
        {
          person.data.linkedin && (
            <a
              href={
                person.data.linkedin.startsWith('http')
                  ? person.data.linkedin
                  : `https://www.linkedin.com/in/${person.data.linkedin}`
              }
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs"
              style="color: var(--global-text-color-light); text-decoration: none;"
              aria-label="LinkedIn"
              title="LinkedIn"
            >
              <IconLinkedin />
            </a>
          )
        }
        {
          person.data.scholar && (
            <a
              href={`https://scholar.google.com/citations?user=${person.data.scholar}`}
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs"
              style="color: var(--global-text-color-light); text-decoration: none;"
              aria-label="Google Scholar"
              title="Google Scholar"
            >
              <IconScholar />
            </a>
          )
        }
      </div>

      {person.data.description && <p class="who-en member-bio">{person.data.description}</p>}
      {
        person.data.descriptionFa && (
          <p class="who-fa member-bio" lang="fa" dir="rtl">
            {person.data.descriptionFa}
          </p>
        )
      }
    </div>
  </div>
</div>

<style>
  .member-card {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--global-divider-color);
    border-radius: 22px;
    transition:
      transform 0.25s ease,
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }

  .member-card:hover {
    transform: translateY(-5px);
    border-color: color-mix(in srgb, var(--global-theme-color) 45%, transparent);
    box-shadow: 0 18px 44px rgba(0, 0, 0, 0.14);
  }

  .member-inner {
    height: 100%;
    border-radius: 20px;
    padding: 1.5rem 1.25rem 1.25rem;
    background:
      radial-gradient(circle at 85% 10%, rgba(255, 122, 24, 0.12), transparent 55%),
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--global-card-bg-color) 92%, transparent) 0%,
        color-mix(in srgb, var(--global-card-bg-color) 55%, transparent) 100%
      );
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    -webkit-mask-image: linear-gradient(to bottom, black 93%, transparent 100%);
    mask-image: linear-gradient(to bottom, black 93%, transparent 100%);
  }

  /* Gold supervisor ring (DINA identity) — same glass as students. */

  .member-avatar-ring {
    position: relative;
    width: 104px;
    height: 104px;
    margin: 0 auto 0.9rem;
    border-radius: 50%;
    padding: 4px;
    background: linear-gradient(145deg, var(--global-theme-color), var(--global-gold-color));
    display: grid;
    place-items: center;
  }

  /* Horizontal supervisor layout: avatar beside the content, full row. */
  .member-card.is-horizontal .member-inner {
    display: flex;
    gap: 1.75rem;
    align-items: center;
    text-align: start;
    padding: 1.75rem 2rem;
  }

  .member-card.is-horizontal .member-avatar-ring {
    flex: 0 0 auto;
    width: 128px;
    height: 128px;
    margin: 0;
  }

  .member-card.is-horizontal .member-focus {
    justify-content: flex-start;
  }

  .member-card.is-horizontal .member-socials {
    justify-content: flex-start;
  }

  .member-card.is-horizontal .member-body {
    flex: 1 1 auto;
    min-width: 0;
  }

  /* Phones: the card spans the full width, so the vertical rhythm is trimmed
     (padding, avatar ring, gaps around the chip block) to remove the empty
     glass around the content. */
  @media (max-width: 640px) {
    .member-inner {
      padding: 1rem 0.95rem 0.9rem;
    }

    .member-avatar-ring {
      width: 84px;
      height: 84px;
      margin-bottom: 0.7rem;
    }

    .member-initial {
      font-size: 1.75rem;
    }

    .member-focus {
      gap: 0.28rem;
      margin-top: 0.6rem;
      margin-bottom: 0.65rem;
    }

    .focus-chip {
      padding: 0.16rem 0.5rem;
    }

    .member-bio {
      margin-top: 0.55rem;
    }

    .member-card.is-horizontal .member-inner {
      flex-direction: column;
      text-align: center;
      padding: 1.1rem 1rem 1rem;
    }

    .member-card.is-horizontal .member-avatar-ring {
      width: 96px;
      height: 96px;
      margin: 0 auto 0.7rem;
    }

    .member-card.is-horizontal .member-focus,
    .member-card.is-horizontal .member-socials {
      justify-content: center;
    }
  }

  .is-lead .member-avatar-ring {
    background: linear-gradient(145deg, var(--global-gold-color), #fff0a6, #a7731d);
    box-shadow: 0 6px 24px rgba(226, 182, 87, 0.35);
  }

  .member-avatar-ring img {
    position: absolute;
    inset: 4px;
    width: calc(100% - 8px);
    height: calc(100% - 8px);
    border-radius: 50%;
    object-fit: cover;
    background: var(--global-card-bg-color);
  }

  .member-initial {
    font-size: 2.2rem;
    font-weight: 700;
    color: var(--global-text-color-light);
  }

  .member-name {
    font-size: 1.02rem;
    font-weight: 700;
    color: var(--global-theme-color);
    margin-bottom: 0.15rem;
  }

  .member-role {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--global-text-color-light);
  }

  .member-focus {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.35rem;
    margin-top: 0.8rem;
    margin-bottom: 0.9rem;
  }

  .focus-chip {
    font-size: 0.68rem;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    border: 1px solid var(--global-divider-color);
    background: color-mix(in srgb, var(--global-theme-color) 8%, transparent);
    color: var(--global-text-color);
    white-space: nowrap;
  }

  .member-bio {
    font-size: 0.8rem;
    line-height: 1.65;
    color: var(--global-text-color-light);
    margin-top: 0.8rem;
    margin-bottom: 0;
  }
</style>
