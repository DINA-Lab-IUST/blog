---
/**
 * BlogListing — shared blog front page (used at `/` and `/page/N/`).
 * Post pages stay at `/posts/<slug>/`; tag/category/year archives link back here.
 */
import PostCard from '@components/blog/PostCard.astro';
import Pagination from '@components/Pagination.astro';
import { site } from '@config/site';
import { withBase } from '@utils/base';
import { formatCount, normalizeLang, t } from '@utils/i18n';
import { readingTime } from '@utils/reading-time';
import type { CollectionEntry } from 'astro:content';

import IconCalendar from '~icons/fa-solid/calendar';
import IconHashtag from '~icons/fa-solid/hashtag';
import IconTag from '~icons/fa-solid/tag';
import IconTags from '~icons/fa-solid/tags';
import IconThumbtack from '~icons/fa-solid/thumbtack';

type LocalPost = CollectionEntry<'posts'>;

interface ExternalPost {
  external: true;
  id: string;
  url: string;
  data: {
    title: string;
    date: Date;
    description?: string;
    tags: string[];
    categories: string[];
    image?: string;
  };
  body?: undefined;
}

type PostEntry = LocalPost | ExternalPost;

interface Props {
  pagePosts: PostEntry[];
  pinnedPosts: LocalPost[];
  currentPage: number;
  totalPages: number;
  prevUrl?: string;
  nextUrl?: string;
  basePath: string;
}

const { pagePosts, pinnedPosts, currentPage, totalPages, prevUrl, nextUrl, basePath } = Astro.props;

const displayTags = site.blog.displayTags;
const displayCategories = site.blog.displayCategories;

// Grid column count for featured cards
const featuredCols = pinnedPosts.length >= 3 ? '3' : '2';

// Group pagePosts by year for the list section
const postsByYear = new Map<number, typeof pagePosts>();
for (const post of pagePosts) {
  const year = post.data.date.getFullYear();
  if (!postsByYear.has(year)) postsByYear.set(year, []);
  postsByYear.get(year)!.push(post);
}
const postYears = [...postsByYear.keys()].sort((a, b) => b - a);
---

<!-- Header hero -->
<div class="blog-hero">
  <div class="blog-hero-glow" aria-hidden="true"></div>
  <img
    class="blog-mark"
    src={withBase('/assets/logo/DINA-logo.png')}
    alt="DINA Lab logo"
    width="120"
    height="120"
    loading="eager"
    fetchpriority="high"
  />
  <h1 data-i18n="blogName">{site.blog.name}</h1>
  <p class="blog-lede" data-i18n="blogDesc">{site.blog.description}</p>
</div>

<!-- Tag / category list + all-tags link -->
<div class="tag-category-list">
  <ul class="m-0 p-0">
    {
      displayTags.map((tag, i) => (
        <>
          <li>
            <IconHashtag /> <a href={`${site.base}/posts/tag/${tag}/`}>{tag}</a>
          </li>
          {i < displayTags.length - 1 && <p>&bull;</p>}
        </>
      ))
    }
    {displayTags.length > 0 && displayCategories.length > 0 && <p>&bull;</p>}
    {
      displayCategories.map((cat, i) => (
        <>
          <li>
            <IconTag /> <a href={`${site.base}/posts/category/${cat}/`}>{cat}</a>
          </li>
          {i < displayCategories.length - 1 && <p>&bull;</p>}
        </>
      ))
    }
    {(displayTags.length > 0 || displayCategories.length > 0) && <p>&bull;</p>}
    <li>
      <IconTags />{' '}
      <a href={`${site.base}/posts/tags/`} data-i18n="allTags">all tags</a>
    </li>
  </ul>
</div>

<!-- Featured / Pinned posts card grid -->
{
  pinnedPosts.length > 0 && (
    <>
      <br />
      <div class="featured-posts container">
        <div class={`row row-cols-${featuredCols}`}>
          {pinnedPosts.map((post) => {
            const mins = post.body ? readingTime(post.body, site.blog.wordsPerMinute) : 1;
            const year = post.data.date.getFullYear();
            // Pinned cards follow their OWN post language, like regular cards.
            const postLang = normalizeLang((post.data as { lang?: string }).lang);
            return (
              <div class="col mb-4">
                <a href={`${site.base}/posts/${post.id}/`}>
                  <div
                    class="card hoverable"
                    lang={postLang}
                    dir={postLang === 'fa' ? 'rtl' : 'ltr'}
                  >
                    <div class="row g-0">
                      <div class="col-md-12">
                        <div class="card-body">
                          <div class="float-right">
                            <IconThumbtack style="font-size:0.75rem;" />
                          </div>
                          <h3 class="card-title text-lowercase">{post.data.title}</h3>
                          {post.data.description && (
                            <p class="card-text">{post.data.description}</p>
                          )}
                          <p class="post-meta">
                            <span>
                              {t(postLang, 'minReadN').replace('{n}', formatCount(mins, postLang))}
                            </span>{' '}
                            &nbsp;&middot;&nbsp;
                            <span>
                              <IconCalendar style="font-size:0.75rem;" /> {year}
                            </span>
                          </p>
                        </div>
                      </div>
                    </div>
                  </div>
                </a>
              </div>
            );
          })}
        </div>
      </div>
      <hr style="margin-bottom: 2rem;" />
    </>
  )
}

<!-- Post list grouped by year -->
{
  pagePosts.length === 0 ? (
    <p style="color: var(--global-text-color-light); padding-top: 2rem;" data-i18n="blogEmpty">
      {site.blog.emptyMessage}
    </p>
  ) : (
    postYears.map((year) => (
      <>
        <h2 class="year">
          <a
            href={`${site.base}/posts/year/${year}/`}
            style="color: inherit; text-decoration: none;"
          >
            {year}
          </a>
        </h2>
        <ul class="post-list">
          {postsByYear.get(year)!.map((post) => (
            <li>
              <PostCard post={post} />
            </li>
          ))}
        </ul>
      </>
    ))
  )
}

<Pagination
  currentPage={currentPage}
  totalPages={totalPages}
  prevUrl={prevUrl}
  nextUrl={nextUrl}
  basePath={basePath}
/>
